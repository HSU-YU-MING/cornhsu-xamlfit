<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:p="clr-namespace:WindowsFonts.Resources"
        Title="XamlFit Windows fonts sample" Width="320" SizeToContent="Height"
        FontFamily="Segoe UI" FontSize="12">

  <!-- Action 的 export-fonts 的 CI 樣本：字型來自 Windows runner 自己的 Segoe UI，度量檔不進 repo。
       Save 的德文放不下 60 寬（fail），Ok 放得下。只在 Windows runner 上跑（ci.yml 的 action-windows）。 -->
  <StackPanel Margin="8">
    <TextBlock Width="60" HorizontalAlignment="Left" Text="{x:Static p:Strings.Save}"/>
    <TextBlock Width="200" HorizontalAlignment="Left" Text="{x:Static p:Strings.Ok}"/>
  </StackPanel>
</Window>
